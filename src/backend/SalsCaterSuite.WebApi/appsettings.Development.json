{
  // Serilog owns the logging pipeline (DEC-092). The Development file mirrors the levels the
  // legacy "Logging:LogLevel" subtree had before Serilog took over, so the Development console's
  // verbosity does not change silently. It does NOT repeat "WriteTo": an array in an environment
  // file replaces the base array rather than merging with it.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  // The request logger's behaviour (specification §5.2) — identical to the base configuration.
  "Logging": {
    "RequestLogging": {
      "Enabled": true,
      "LogRequestBody": true,
      "LogResponseBody": true,
      "MaxBodyLengthBytes": 8192,
      "SensitiveFieldNames": [
        "password",
        "passwordconfirmation",
        "newpassword",
        "confirmpassword",
        "token",
        "accesstoken",
        "refreshtoken",
        "idtoken",
        "jwt",
        "secret",
        "secretkey",
        "apikey",
        "api_key",
        "authorization",
        "clientsecret",
        "signature",
        "privatekey",
        "connectionstring",
        "username",
        "userName",
        "createdbyuser",
        "address",
        "contact",
        "contact1",
        "contact2",
        "customercontact",
        "email",
        "emailaddress",
        "tin"
      ],
      "SensitiveQueryParameterNames": [
        "password",
        "passwordconfirmation",
        "newpassword",
        "confirmpassword",
        "token",
        "accesstoken",
        "refreshtoken",
        "idtoken",
        "jwt",
        "secret",
        "secretkey",
        "apikey",
        "api_key",
        "authorization",
        "clientsecret",
        "signature",
        "privatekey",
        "connectionstring",
        "username",
        "userName",
        "createdbyuser",
        "address",
        "contact",
        "contact1",
        "contact2",
        "customercontact",
        "email",
        "emailaddress",
        "tin",
        "access_token",
        "search"
      ],
      "ClientErrorLevel": "Warning",
      "ServerErrorLevel": "Error",
      // The Swagger UI page is a text/html document, so BR-21.7 treats it as textual and it would
      // be captured (and truncated) on every page load. It is excluded in Development only; the
      // base configuration keeps the list empty because the requirement is a record for EVERY
      // endpoint (specification §5.2).
      "ExcludedPathPrefixes": [
        "/swagger"
      ]
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true
  },
  "ConnectionStrings": {
    // LocalDB dev/test database only (DEC-019, DEC-020, DEC-031). Auto-migration/auto-seeding is
    // enabled in Development, so this must NEVER point at a shared or production server.
    // A different database can be selected without committing credentials by overriding
    // ConnectionStrings__SalsCaterSuiteDb via user-secrets or an environment variable.
    "SalsCaterSuiteDb": "Server=(localdb)\\mssqllocaldb;Database=SalsCaterSuiteDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Seed": {
    "Admin": {
      "Email": "admin@salscatersuite.local",
      "UserName": "admin@salscatersuite.local",
      "Password": "Admin@12345",
      "FirstName": "System",
      "LastName": "Administrator"
    }
  },
  "Jwt": {
    "SecretKey": "SalsCaterSuite_SuperSecret_JWT_Key_2024_Dev!",
    "Issuer": "SalsCaterSuite.Api",
    "Audience": "SalsCaterSuite.Client"
  }
}
