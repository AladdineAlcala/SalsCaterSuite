{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true
  },
  "ConnectionStrings": {
    // LocalDB dev/test database only (DEC-019, DEC-020, DEC-031). Auto-migration/auto-seeding is
    // enabled in Development, so this must NEVER point at a shared or production server.
    // A different database can be selected without committing credentials by overriding
    // ConnectionStrings__SalsCaterSuiteDb via user-secrets or an environment variable.
    "SalsCaterSuiteDb": "Server=(localdb)\\mssqllocaldb;Database=SalsCaterSuiteDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Seed": {
    "Admin": {
      "Email": "admin@salscatersuite.local",
      "UserName": "admin@salscatersuite.local",
      "Password": "Admin@12345",
      "FirstName": "System",
      "LastName": "Administrator"
    }
  },
  "Jwt": {
    "SecretKey": "SalsCaterSuite_SuperSecret_JWT_Key_2024_Dev!",
    "Issuer": "SalsCaterSuite.Api",
    "Audience": "SalsCaterSuite.Client"
  }
}
