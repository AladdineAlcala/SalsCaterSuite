{
  // Serilog owns the logging pipeline (DEC-092). The "Serilog" section is the destination
  // list (BR-23.1): adding, removing or reordering a sink is an appsettings edit, not a rebuild.
  // A DataDog deployment tails the JSON file below with the Datadog Agent (DEC-095) — this
  // project carries no DataDog package.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/salscatersuite-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Properties": {
      "Application": "SalsCaterSuite.Api"
    }
  },
  // The request logger's behaviour (specification §5.2). The sensitive-name sets are
  // configuration, not code (BR-21.3), so they can be changed without a rebuild.
  "Logging": {
    "RequestLogging": {
      "Enabled": true,
      "LogRequestBody": true,
      "LogResponseBody": true,
      "MaxBodyLengthBytes": 8192,
      "SensitiveFieldNames": [
        "password",
        "passwordconfirmation",
        "newpassword",
        "confirmpassword",
        "token",
        "accesstoken",
        "refreshtoken",
        "idtoken",
        "jwt",
        "secret",
        "secretkey",
        "apikey",
        "api_key",
        "authorization",
        "clientsecret",
        "signature",
        "privatekey",
        "connectionstring",
        "username",
        "userName",
        "createdbyuser",
        "address",
        "contact",
        "contact1",
        "contact2",
        "customercontact",
        "email",
        "emailaddress",
        "tin"
      ],
      "SensitiveQueryParameterNames": [
        "password",
        "passwordconfirmation",
        "newpassword",
        "confirmpassword",
        "token",
        "accesstoken",
        "refreshtoken",
        "idtoken",
        "jwt",
        "secret",
        "secretkey",
        "apikey",
        "api_key",
        "authorization",
        "clientsecret",
        "signature",
        "privatekey",
        "connectionstring",
        "username",
        "userName",
        "createdbyuser",
        "address",
        "contact",
        "contact1",
        "contact2",
        "customercontact",
        "email",
        "emailaddress",
        "tin",
        "access_token",
        "search"
      ],
      "ClientErrorLevel": "Warning",
      "ServerErrorLevel": "Error",
      "ExcludedPathPrefixes": []
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "BookingLifecycle": {
    "Enabled": false,
    "PollIntervalMinutes": 1,
    "BatchSize": 100
  },
  "Dashboard": {
    "Benchmarks": {
      "TargetFoodCostPercentage": 35.0
    }
  },
  "ConnectionStrings": {
    "SalsCaterSuiteDb": "Server=(localdb)\\mssqllocaldb;Database=SalsCaterSuiteDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "SecretKey": "SalsCaterSuite_SuperSecret_JWT_Key_2024_ChangeInProd!",
    "Issuer": "SalsCaterSuite.Api",
    "Audience": "SalsCaterSuite.Client"
  }
}
