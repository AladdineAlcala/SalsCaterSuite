<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!--
      Design-time-only dependency required for the EF Core CLI (`dotnet ef`) to resolve the
      DbContext against this startup project. PrivateAssets=all keeps it out of the published
      application and out of downstream consumers.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SalsCaterSuite.Application\SalsCaterSuite.Application.csproj" />
    <ProjectReference Include="..\SalsCaterSuite.Infrastructure\SalsCaterSuite.Infrastructure.csproj" />
  </ItemGroup>

</Project>
