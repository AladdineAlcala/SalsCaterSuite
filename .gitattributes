# ---------------------------------------------------------------------------
# Sal's CaterSuite — repository-root line-ending and binary rules
#
# Applies to the whole monorepo. The backend project keeps its own scoped
# .gitattributes at src/backend/.gitattributes, which continues to govern
# everything under src/backend/.
# ---------------------------------------------------------------------------

# Normalize line endings for every text file in the repository.
* text=auto

# Visual Studio solution and project files.
*.sln text eol=crlf
*.slnx text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Shell and Node tooling must stay LF so they execute correctly on POSIX.
*.sh text eol=lf
*.mjs text eol=lf
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.xlsx binary
*.docx binary
