# ---------------------------------------------------------------------------
# Local Docker deployment secrets. Copy to `.env` (git-ignored) - the deploy
# script does this for you on first run.
#
# Keep SQL_SA_PASSWORD to letters, digits, `!` and `_`. A `;` or `$` corrupts
# the connection string that docker-compose builds from it.
# ---------------------------------------------------------------------------
SQL_SA_PASSWORD=SalsCaterSuite_Local_2026!
JWT_SECRET=SalsCaterSuite_Docker_Local_Key_Change_Me_2026!

# ---------------------------------------------------------------------------
# Host ports. The defaults avoid the two things already running on a typical
# dev machine: the local `dotnet watch` API on 5149 and a native/container
# SQL Server on 1433.
# ---------------------------------------------------------------------------
WEB_HOST_PORT=8080
API_HOST_PORT=5150
DB_HOST_PORT=14330
